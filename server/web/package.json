{
  "name": "picobrew-hub-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-pdf-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-pdf-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"*.{ts,json,md}\" \"tests/**/*.{ts,tsx,mjs}\"",
    "test:integration": "node tests/run-dom.mjs",
    "build:bundle": "npm run build && node scripts/package-web.mjs",
    "check:bundle": "node scripts/package-web.mjs --check",
    "test:bundle": "node --test scripts/package-web.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.75.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.11.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eventsource": "5.1.5",
    "fflate": "0.8.3",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
